#!/bin/bash
# 安装/升级后：修权限 → 重新生成作用域白名单 → 让 SpringBoard/相机重载 dylib
# rootless: 脚本跑在真实 rootfs，越狱根在 /var/jb
# roothide: 脚本跑在 bootstrap vroot，"/" 就是随机命名的 jbroot，真机 rootfs 挂在 /rootfs
if [ -d /rootfs/var/mobile ]; then
    JB=""
elif [ -d /var/jb/Library ]; then
    JB=/var/jb
else
    JB=""
fi
DL="$JB/Library/MobileSubstrate/DynamicLibraries"
chmod 755 "$DL/VCam.dylib" 2>/dev/null
chmod 644 "$DL/VCam.plist" 2>/dev/null
chmod 644 "$DL/VCam.base" 2>/dev/null
[ -f "$JB/usr/bin/vcam-refresh" ] && chmod 755 "$JB/usr/bin/vcam-refresh"

# 生成白名单：系统清单 + 所有声明了相机权限的已装 App
if [ -x "$JB/usr/bin/vcam-refresh" ]; then
    "$JB/usr/bin/vcam-refresh"
elif [ -f "$JB/usr/bin/vcam-refresh" ]; then
    /bin/bash "$JB/usr/bin/vcam-refresh"
fi

# 已在跑的进程仍持有旧 dylib，必须一起杀掉
killall -9 SpringBoard 2>/dev/null
killall -9 Camera 2>/dev/null

exit 0
